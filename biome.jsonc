{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": {
    // .claude holds tool-managed git worktrees, each a full copy of the repository with its own
    // configuration, and Biome refuses to run when it finds a second root.
    "includes": ["**", "!build", "!dist", "!site", "!node_modules", "!.venv", "!.claude", "!**/*.html"],
    // test/regressions.ts is one suite in one file, run by name through one loose matcher, and it
    // passed the default of a mebibyte. Past the limit Biome skips the file and warns, which the
    // lint gate fails on, so the file is read rather than split to fit a performance default.
    "maxSize": 4194304
  },
  "json": {
    "parser": {
      // oxlint reads its config as JSONC, and a rule list of this size is unreadable without
      // somewhere to say why each block is there.
      "allowComments": true
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        // Off because it contradicts the type checker, which is the stronger of the two here.
        // noPropertyAccessFromIndexSignature requires obj['key'] wherever key comes from an
        // index signature, so that a typo is a visible lookup rather than a silent undefined;
        // useLiteralKeys asks for obj.key back. One of them has to yield and correctness wins.
        // Neither fires once the tool arguments are real types instead of index signatures.
        "useLiteralKeys": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
