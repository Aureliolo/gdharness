# gdlint's defaults with the size limits stated rather than inherited. Only changed keys are
# listed; everything else stays at gdlint's own default, which is already strict about
# naming and definition order.
#
# Nothing is disabled. `disable: []` is deliberate: a rule that fires on good code is a
# reason to argue about the rule, not to switch it off quietly.
disable: []

# gdlint's own default. It was 600 here for a while, which was a number picked rather than
# measured: it failed two ordinary tool modules at 720 and 849 lines alongside the 4400-line
# godot_operations.gd, which was the only one that was genuinely a problem. That file is a 191-line
# dispatcher now and nothing fails this. What a tightening would have to answer for is
# scene_tools.gd at 935, so the number to beat is that one rather than anything left over from the
# dispatcher, and picking one under it without having read that file is how 600 happened.
max-file-lines: 1000

# gdlint's default is 10, which is enough arguments to hide a missing struct.
function-arguments-number: 6

# gdlint's default is 6, which fights the shape this project mandates: a tool fails rather than
# answers, so every argument gets a guard clause with its own return, and no-else-return then
# demands those be flat. Measured across the addons, a genuine validator tops out at 9 returns
# and everything above 12 was a type dispatcher pretending to be a function. 12 admits the
# validators and still catches the thing the rule is for.
max-returns: 12

# Matches Biome's lineWidth for TypeScript, so both languages wrap at the same column.
max-line-length: 110

# gdlint's own pattern with a leading underscore allowed. The engine and the linter disagreed
# here: a call whose answer is genuinely not wanted still cannot drop it, because a project can
# hold return_value_discarded at error level, and the parser's own advice for the local that
# catches it is "prefix it with an underscore". gdlint then refused the name the parser asked
# for. Only the prefix is admitted; the rest of snake_case still holds.
function-variable-name: '^_?[a-z][a-z0-9]*(_[a-z0-9]+)*$'
