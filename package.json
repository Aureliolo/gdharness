{
  "name": "gdharness",
  "version": "0.4.0",
  "packageManager": "bun@1.4.2",
  "mcpName": "io.github.Aureliolo/gdharness",
  "description": "A harness for driving a Godot 4 project from an agent: editor addons, a runtime bridge into the running game, an MCP server in front of them, and a CLI that installs and diagnoses the Godot side.",
  "type": "module",
  "main": "./build/index.js",
  "bin": {
    "gdharness": "build/cli.js"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun scripts/build-release.ts",
    "docs": "bun scripts/build-docs.ts",
    "typecheck": "tsc --noEmit",
    "format": "bun x biome format --write . && bun run format:prose",
    "format:check": "bun x biome format . && bun run format:prose:check",
    "format:prose": "prettier --write .",
    "format:prose:check": "prettier --check .",
    "lint": "bun run lint:biome && bun run lint:types && bun run lint:dead && bun run lint:prose",
    "lint:fix": "bun x biome check --write . && oxlint --type-aware --fix src test scripts && markdownlint-cli2 --fix",
    "lint:biome": "bun x biome check .",
    "lint:types": "oxlint --type-aware --deny-warnings src test scripts",
    "lint:dead": "KNIP_DISABLE_RAW_TRANSFER=1 knip",
    "lint:prose": "markdownlint-cli2",
    "lint:gd": "gdlint src/godot test/support/gd",
    "format:gd": "gdformat --line-length=110 src/godot test/support/gd",
    "format:gd:check": "gdformat --check --line-length=110 src/godot test/support/gd",
    "test": "bun run test:ci",
    "test:smoke": "bun test/smoke.ts",
    "test:integration": "bun test/bridge.ts",
    "test:regressions": "bun test/regressions.ts",
    "test:detection": "bun test/godot-detection.ts",
    "test:engine": "bun test/engine-gdscript.ts",
    "test:editor": "bun test/editor.ts",
    "test:zip": "bun test/zip-extract.ts",
    "test:fuzz": "bun test/fuzz.ts",
    "test:game-log": "bun test/game-log.ts",
    "test:junit": "bun test/junit.ts",
    "test:harnesses": "bun test/harnesses.ts",
    "test:node-runtime": "bun run build && bun test/node-runtime.ts",
    "test:ci": "bun test/smoke.ts && bun test/regressions.ts && bun test/godot-detection.ts && bun test/zip-extract.ts && bun test/game-log.ts && bun test/junit.ts && bun test/harnesses.ts && bun test/node-runtime.ts && bun test/fuzz.ts",
    "test:metadata": "bun run build && bun test/metadata-consistency.ts && bun test/version-bump.ts",
    "test:version-bump": "bun test/version-bump.ts",
    "test:packaging": "bun run release:pack && bun test/packaging-consistency.ts",
    "ci": "bun run build && bun run typecheck && bun run test:ci",
    "watch": "tsc --watch",
    "pack": "bun run release:pack",
    "release:pack": "bun run build && bun scripts/pack-release.ts",
    "version:bump": "bun scripts/bump-version.ts"
  },
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.4.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@tsconfig/strictest": "2.0.8",
    "@types/bun": "1.4.2",
    "@types/node": "26.5.1",
    "@types/ws": "8.18.1",
    "fast-check": "4.10.0",
    "knip": "6.35.1",
    "markdownlint-cli2": "0.23.2",
    "marked": "18.0.13",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aureliolo/gdharness.git"
  },
  "homepage": "https://github.com/Aureliolo/gdharness#readme",
  "bugs": {
    "url": "https://github.com/Aureliolo/gdharness/issues"
  },
  "author": {
    "name": "Aurelio Amoroso",
    "url": "https://github.com/Aureliolo"
  },
  "keywords": [
    "gdharness",
    "godot",
    "godot-engine",
    "godot4",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai",
    "ai-tools",
    "ai-integration",
    "claude",
    "cline",
    "opencode",
    "cursor",
    "game-development",
    "gamedev",
    "game-engine",
    "gdscript",
    "language-server",
    "lsp",
    "dap",
    "debug-adapter-protocol",
    "screenshot",
    "input-injection",
    "auto-reload",
    "developer-tools",
    "typescript"
  ]
}
